  <MaintainerUrl>https://design-studio.local</MaintainerUrl>
  <DesktopFileName>designstudio</DesktopFileName>
  <StartWorkbench>DesignStudioWorkbench</StartWorkbench>
  <AppDataSkipVendor>true</AppDataSkipVendor>
</Branding>
