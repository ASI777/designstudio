  "components_to_add": [
    {
      "ref": "U2",
      "op": "add",
      "mpn": "MPM3833C",
      "manufacturer": "Monolithic Power Systems",
      "reason": "U1 core supply (VDD, ~14 balls) has no source. Highest-current rail; provisional until power_domains/DC characteristics give the real load.",
      "priority": 1
    },
    {
      "ref": "U3",
      "op": "add",
      "mpn": "MPM3610",
      "manufacturer": "Monolithic Power Systems",
      "reason": "VDD18, VDD25, VDDAUXx and per-bank VDDIx supplies are all unsourced. Per PPAT note, every used bank's VDDI/VDDAUX must be powered even if I/O is unused.",
      "priority": 1
    },
    {
      "ref": "U4",
      "op": "add",
      "mpn": "TPS7A2018",
      "manufacturer": "Texas Instruments",
      "reason": "VDDA and the transceiver/clock analog rails need a quiet supply for PLL/SerDes jitter; a filtered LDO off the core rail is standard practice.",
      "priority": 2
    },
    {
      "ref": "U5",
      "op": "add",
      "mpn": "GRM155R71C104KA88",
      "manufacturer": "Murata",
      "reason": "U1.electrical.required_externals and BGA practice: every VDD/VDDA/VDDI ball group needs local decoupling. None present. Binding requirement before power-up.",
      "priority": 1
    },
    {
      "ref": "U6",
      "op": "add",
      "mpn": "MT40A256M16GE-083E",
      "manufacturer": "Micron",
      "reason": "MSS_DDR interface (53 balls) is present and a Linux-class FOC controller needs external DRAM; none placed. Requires a length-matched, 80-90 ohm-class net class.",
      "priority": 1
    },
    {
      "ref": "U7",
      "op": "add",
      "mpn": "MT25QL128ABA1ESE",
      "manufacturer": "Micron",
      "reason": "PolarFire SoC boots from external SPI/QSPI flash; no boot device present. Connects to the dedicated SPI (SCK/SS/SDI/SDO) pins.",
      "priority": 1
    },
    {
      "ref": "U8",
      "op": "add",
      "mpn": "SiT9120AI",
      "manufacturer": "SiTime",
      "reason": "MSS_REFCLK and XCVR REFCLK diff pairs exist in the high_speed list but have no source. SerDes/Ethernet need a clean reference clock.",
      "priority": 2
    },
    {
      "ref": "U9",
      "op": "add",
      "mpn": "DRV8353RS",
      "manufacturer": "Texas Instruments",
      "reason": "Core of the FOC stage and entirely missing. Takes 6 PWM/INHx-INLx from FPGA fabric, drives the 6 MOSFETs, and provides the 3 phase-current sense channels FOC needs. Integrated CSAs save parts and improve match.",
      "priority": 2
    },
    {
      "ref": "U10",
      "op": "add",
      "mpn": "BSC0902NSI",
      "manufacturer": "Infineon",
      "reason": "Three-phase inverter bridge for the motor; none present. Example OptiMOS part \u2014 final choice depends on bus voltage/current, which set the whole power stage.",
      "priority": 2
    },
    {
      "ref": "U11",
      "op": "add",
      "mpn": "AM26LV32E",
      "manufacturer": "Texas Instruments",
      "reason": "Position feedback (quadrature / BiSS / EnDat) needs differential receivers into the FPGA fabric; encoder interface is missing. Choose per encoder protocol.",
      "priority": 3
    },
    {
      "ref": "U12",
      "op": "add",
      "mpn": "DP83822IF",
      "manufacturer": "Texas Instruments",
      "reason": "Stretch-goal EtherCAT: needs two PHYs feeding an EtherCAT Slave Controller implemented in fabric. Note ESC IP licensing (Beckhoff/Microchip) is a separate requirement.",
      "priority": 4
    },
    {
      "ref": "U13",
      "op": "add",
      "mpn": "FTSH-105-01-L-DV-K",
      "manufacturer": "Samtec",
      "reason": "TMS/TCK/TDI/TDO/TRSTB are unconnected; a programming/debug header is required to load the device.",
      "priority": 3
    }
  ],
  "notes": []
}