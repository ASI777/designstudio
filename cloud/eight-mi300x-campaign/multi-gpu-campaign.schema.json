{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designstudio.local/schemas/multi-gpu-campaign-1.json",
  "title": "Digest-bound one-to-eight GPU campaign",
  "type": "object",
  "required": ["schema", "campaign_id", "policy", "lanes", "jobs"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "multi-gpu-campaign/1"},
    "campaign_id": {"type": "string", "minLength": 1},
    "policy": {
      "type": "object",
      "required": ["maximum_runtime_seconds", "no_start_after_seconds", "destroy_deadline_seconds"],
      "additionalProperties": false,
      "properties": {
        "maximum_runtime_seconds": {"type": "number", "maximum": 18000, "exclusiveMinimum": 0},
        "no_start_after_seconds": {"type": "number", "maximum": 14400, "exclusiveMinimum": 0},
        "destroy_deadline_seconds": {"const": 18000}
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["gpu", "rocr_visible_devices"],
        "additionalProperties": false,
        "properties": {
          "gpu": {"type": "integer", "minimum": 0, "maximum": 7},
          "rocr_visible_devices": {"enum": ["0", "1", "2", "3", "4", "5", "6", "7"]}
        }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "preferred_gpu", "compatible_gpus", "expert_role",
          "model_revision", "container_revision", "inputs", "outputs",
          "authority_status", "timeout_seconds", "command"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "preferred_gpu": {"type": "integer", "minimum": 0, "maximum": 7},
          "compatible_gpus": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0, "maximum": 7}
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object", "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
