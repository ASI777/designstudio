FROM rocm/pytorch:rocm6.4.2_ubuntu22.04_py3.10_pytorch_release_2.5.1@sha256:37f41a1cd94019688669a1b20d33ea74156e0c129ef6b8270076ef214a6a1a2c

WORKDIR /app
COPY cloud/support-optimizer-amd/requirements.lock.txt /app/requirements.lock.txt
RUN python3 -m pip install --no-cache-dir -r /app/requirements.lock.txt
COPY services/ai-gateway/support_jobs.py /app/support_jobs.py
COPY cloud/support-optimizer-amd/app.py /app/app.py

ENV DS_SUPPORT_MOCK=0
EXPOSE 8002
ENTRYPOINT ["python3", "-m", "uvicorn"]
CMD ["app:app", "--host", "0.0.0.0", "--port", "8002"]
