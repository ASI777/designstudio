      "use": "thermal_packaging_and_section_access_principles_only",
      "geometry_copy_allowed": false,
      "dimensional_measurement_allowed": false,
      "observations": [
        "A styled exterior depends on a segmented internal housing that retains functional modules.",
        "Dense light or power modules create local high-temperature zones.",
        "Section views are required to prove packaging and heat paths instead of trusting an exterior render.",
        "Housing segmentation should follow assembly thermal and service boundaries."
      ],
      "observed_date": "2026-08-24",
      "source_fingerprint_sha256": "d7369536814280f004585834ccc53796b69e266cdff2843ed4e37c5cdc27ff79"
