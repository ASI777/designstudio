{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:component-placement:1",
  "title": "DesignStudio revision-bound 6-DOF component placement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "placement_id",
    "component_id",
    "component_sha256",
    "document",
    "transform",
    "coordinate_system",
    "snap",
    "locks",
    "clearance_mm"
  ],
  "properties": {
    "schema": {"const": "design-studio.component-placement/1"},
    "placement_id": {"type": "string", "format": "uuid"},
    "component_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"},
    "component_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "revision", "sha256"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "revision": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation_mm", "rotation_xyzw"],
      "properties": {
        "translation_mm": {"$ref": "#/$defs/point3"},
        "rotation_xyzw": {"$ref": "#/$defs/quaternion"}
      }
    },
    "coordinate_system": {
      "enum": ["world", "enclosure_local", "pcb_local", "surface_local"]
    },
    "surface_anchor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["object_id", "face_id", "uv", "normal_world"],
      "properties": {
        "object_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "face_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "uv": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "minItems": 2,
          "maxItems": 2
        },
        "normal_world": {"$ref": "#/$defs/point3"}
      }
    },
    "snap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid", "surface", "axis", "symmetry", "clearance"],
      "properties": {
        "grid": {"type": "boolean"},
        "surface": {"type": "boolean"},
        "axis": {"type": "boolean"},
        "symmetry": {"type": "boolean"},
        "clearance": {"type": "boolean"}
      }
    },
    "locks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "orientation", "surface_anchor"],
      "properties": {
        "position": {"type": "boolean"},
        "orientation": {"type": "boolean"},
        "surface_anchor": {"type": "boolean"}
      }
    },
    "clearance_mm": {"type": "number", "minimum": 0, "maximum": 1000}
  },
  "$defs": {
    "point3": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "minItems": 4,
      "maxItems": 4
    }
  }
}
