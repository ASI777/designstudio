{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:mechanical-cad-program:2",
  "title": "DesignStudio mechanical CAD program v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "program_id", "units", "author", "envelope", "control_datums", "commands", "checks"],
  "properties": {
    "schema": {"const": "design-studio.mechanical-cad-program/2"},
    "program_id": {"$ref": "#/$defs/id"},
    "units": {"const": "mm"},
    "author": {"type": "string", "minLength": 1},
    "envelope": {"$ref": "#/$defs/envelope"},
    "control_datums": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/datum"}},
    "commands": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/command"}},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "number": {"type": "number"},
    "point": {
      "type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3
    },
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["min_mm", "max_mm"],
      "properties": {"min_mm": {"$ref": "#/$defs/point"}, "max_mm": {"$ref": "#/$defs/point"}}
    },
    "datum": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "point_mm", "locked", "digest"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "point_mm": {"$ref": "#/$defs/point"},
        "locked": {"const": true},
        "digest": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "curve": {
      "type": "object", "additionalProperties": false,
      "required": ["degree", "knots", "multiplicities", "weights", "control_points", "closed", "periodic", "classification", "provenance"],
      "properties": {
        "degree": {"type": "integer", "minimum": 1, "maximum": 8},
        "knots": {"type": "array", "minItems": 2, "items": {"type": "number"}},
        "multiplicities": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1}},
        "weights": {"type": "array", "minItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
        "control_points": {"type": "array", "minItems": 2, "maxItems": 2048, "items": {"$ref": "#/$defs/point"}},
        "closed": {"type": "boolean"},
        "periodic": {"type": "boolean"},
        "classification": {"enum": ["reference-locked", "compatible-interface", "original-designed"]},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "continuity": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "max_normal_angle_deg"],
      "properties": {
        "required": {"enum": ["G0", "G1", "G2"]},
        "max_normal_angle_deg": {"type": "number", "minimum": 0, "maximum": 180},
        "max_curvature_delta": {"type": "number", "minimum": 0}
      }
    },
    "base": {"type": "object", "additionalProperties": false, "required": ["base"], "properties": {"base": {"$ref": "#/$defs/id"}}},
    "curveCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "op", "params", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "op": {"enum": ["sketch.bspline", "curve.bspline3d"]},
        "params": {"type": "object", "additionalProperties": false, "required": ["curve"], "properties": {"curve": {"$ref": "#/$defs/curve"}, "plane": {"enum": ["XY", "XZ", "YZ"]}}},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "loftCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "op", "params", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "op": {"const": "feature.loft"},
        "params": {"type": "object", "additionalProperties": false, "required": ["sections"], "properties": {"sections": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/id"}}, "solid": {"type": "boolean"}, "ruled": {"type": "boolean"}, "closed": {"type": "boolean"}, "continuity": {"$ref": "#/$defs/continuity"}}},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "guidedLoftCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "op", "params", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "op": {"const": "feature.guided_loft"},
        "params": {"type": "object", "additionalProperties": false, "required": ["sections", "guides", "guide_tolerance_mm"], "properties": {"sections": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/id"}}, "guides": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "guide_tolerance_mm": {"type": "number", "exclusiveMinimum": 0}, "solid": {"type": "boolean"}, "ruled": {"type": "boolean"}, "continuity": {"$ref": "#/$defs/continuity"}}},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "fillCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "op", "params", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "op": {"const": "feature.surface_fill"},
        "params": {"type": "object", "additionalProperties": false, "required": ["boundaries"], "properties": {"boundaries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "continuity": {"$ref": "#/$defs/continuity"}}},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "thickenCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "op", "params", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "op": {"const": "feature.thicken"},
        "params": {"type": "object", "additionalProperties": false, "required": ["base", "thickness_mm", "mode"], "properties": {"base": {"$ref": "#/$defs/id"}, "thickness_mm": {"type": "number", "exclusiveMinimum": 0}, "mode": {"enum": ["remove_faces", "closed_offset_shell"]}, "remove_faces": {"type": "array", "items": {"type": "integer", "minimum": 1}}}},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "ribCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "op", "params", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "op": {"const": "feature.rib"},
        "params": {"type": "object", "additionalProperties": false,
          "required": ["start_mm", "end_mm", "thickness_mm", "height_mm"],
          "properties": {
            "start_mm": {"$ref": "#/$defs/point"},
            "end_mm": {"$ref": "#/$defs/point"},
            "thickness_mm": {"type": "number", "exclusiveMinimum": 0},
            "height_mm": {"type": "number", "exclusiveMinimum": 0},
            "draft_deg": {"type": "number", "minimum": 0, "maximum": 45},
            "root_fillet_mm": {"type": "number", "minimum": 0}
          }
        },
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "booleanCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "op", "params", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "op": {"const": "feature.boolean"},
        "params": {"type": "object", "additionalProperties": false, "required": ["base", "tools", "operation"], "properties": {"base": {"$ref": "#/$defs/id"}, "tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "operation": {"enum": ["cut", "common", "fuse"]}}},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "compoundCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "op", "params", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "op": {"const": "feature.compound"},
        "params": {"type": "object", "additionalProperties": false, "required": ["members"], "properties": {"members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "splitCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "op", "params", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "op": {"const": "feature.split"},
        "params": {"type": "object", "additionalProperties": false, "required": ["base", "plane_origin_mm", "plane_normal"], "properties": {"base": {"$ref": "#/$defs/id"}, "plane_origin_mm": {"$ref": "#/$defs/point"}, "plane_normal": {"$ref": "#/$defs/point"}, "keep": {"enum": ["both", "negative", "positive"]}}},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "drawingCommand": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "op", "params", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "op": {"const": "drawing.project"},
        "params": {"type": "object", "additionalProperties": false, "required": ["base"], "properties": {"base": {"$ref": "#/$defs/id"}, "views": {"type": "array", "minItems": 1, "items": {"enum": ["front", "back", "top", "bottom", "right", "left"]}}, "output_dir": {"type": "string", "minLength": 1}}},
        "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "command": {"oneOf": [{"$ref": "#/$defs/curveCommand"}, {"$ref": "#/$defs/loftCommand"}, {"$ref": "#/$defs/guidedLoftCommand"}, {"$ref": "#/$defs/fillCommand"}, {"$ref": "#/$defs/thickenCommand"}, {"$ref": "#/$defs/ribCommand"}, {"$ref": "#/$defs/booleanCommand"}, {"$ref": "#/$defs/compoundCommand"}, {"$ref": "#/$defs/splitCommand"}, {"$ref": "#/$defs/drawingCommand"}]},
    "check": {"type": "object", "additionalProperties": false, "required": ["kind", "target"], "properties": {"kind": {"enum": ["valid_shape", "watertight", "non_self_intersecting", "solid_count", "volume", "bbox", "rebuild", "artifact"]}, "target": {"$ref": "#/$defs/id"}, "value": {}}}
  }
}
