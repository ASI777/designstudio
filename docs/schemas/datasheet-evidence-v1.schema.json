{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:datasheet-evidence:1",
  "type": "object",
  "required": ["schema", "source_kind", "source", "retrieved_utc", "bytes", "sha256", "expected_mpn", "mpn_match"],
  "properties": {
    "schema": {"const": "design-studio.datasheet-evidence/1"},
    "source_kind": {"enum": ["local", "remote"]},
    "source": {"type": "string", "minLength": 1},
    "final_url": {"type": "string"},
    "retrieved_utc": {"type": "string", "format": "date-time"},
    "bytes": {"type": "integer", "minimum": 4, "maximum": 52428800},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_mpn": {"type": "string", "minLength": 1},
    "mpn_match": {"const": "exact"},
    "discovery_source": {"type": "string"},
    "cache_hit": {"type": "boolean"}
  },
  "additionalProperties": false
}
