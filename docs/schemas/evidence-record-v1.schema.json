{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:evidence-record:1",
  "title": "DesignStudio engineering evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidence_id", "configuration_id", "gate", "status", "method", "source_run", "input_digest", "assumptions", "dependencies", "created_utc"],
  "properties": {
    "schema": {"const": "design-studio.evidence/1"},
    "evidence_id": {"type": "string", "format": "uuid"},
    "configuration_id": {"type": "string", "format": "uuid"},
    "gate": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "fail", "incomplete", "not_applicable"]},
    "method": {"type": "string", "minLength": 1},
    "source_run": {"type": "string", "minLength": 1},
    "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "value": {},
    "unit": {"type": "string"},
    "requirement": {"type": "string"},
    "margin": {"type": "number"},
    "uncertainty": {"type": ["number", "string", "null"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "created_utc": {"type": "string", "format": "date-time"}
  }
}
