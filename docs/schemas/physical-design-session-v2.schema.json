{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:physical-design-session:2",
  "title": "DesignStudio constraint-driven physical design session v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "session_id", "revision", "product_family", "workflow_mode", "document", "intent", "input_assets", "verified_dimensions", "occupied_volumes", "clearance_volumes", "desire_capture", "interaction_objectives", "material_constraints", "manufacturing_constraints", "hard_constraints", "scoring_weights", "unresolved_evidence", "geometry_authority", "candidate_policy", "candidates", "provenance"],
  "properties": {
    "schema": {"const": "design-studio.physical-design-session/2"},
    "session_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "product_family": {"type": "string", "minLength": 1, "maxLength": 128},
    "workflow_mode": {"enum": ["inside_out", "outside_in", "co_design"]},
    "document": {"$ref": "#/$defs/document"},
    "intent": {"type": "string", "minLength": 1, "maxLength": 32000},
    "input_assets": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/asset"}},
    "verified_dimensions": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/measurement"}},
    "occupied_volumes": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/volume"}},
    "clearance_volumes": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/volume"}},
    "desire_capture": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/desire"}},
    "interaction_objectives": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/objective"}},
    "material_constraints": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/material"}},
    "manufacturing_constraints": {"$ref": "#/$defs/manufacturing"},
    "hard_constraints": {"$ref": "#/$defs/hardConstraints"},
    "scoring_weights": {"$ref": "#/$defs/weights"},
    "unresolved_evidence": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1}},
    "geometry_authority": {"$ref": "#/$defs/authority"},
    "candidate_policy": {"$ref": "#/$defs/policy"},
    "candidates": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/candidate"}}]},
    "provenance": {"$ref": "#/$defs/provenance"},
    "ranking_status": {"const": "provisional"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "number": {"type": "number", "finite": true},
    "point": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "bounds": {"type": "object", "additionalProperties": false, "required": ["min_mm", "max_mm"], "properties": {"min_mm": {"$ref": "#/$defs/point"}, "max_mm": {"$ref": "#/$defs/point"}}},
    "document": {"type": "object", "additionalProperties": false, "required": ["document_id", "path", "sha256"], "properties": {"document_id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}}},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "asset": {"type": "object", "additionalProperties": false, "required": ["asset_id", "path", "sha256", "media_type", "input_kind", "role", "geometry_authority", "measurement_status"], "properties": {"asset_id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/digest"}, "media_type": {"enum": ["image/png", "image/jpeg", "image/webp", "image/svg+xml", "application/pdf"]}, "input_kind": {"enum": ["object_photo", "render", "hand_sketch", "vector_sketch", "engineering_drawing", "scan"]}, "role": {"enum": ["inspiration", "silhouette", "layout", "measurement_reference", "material_reference"]}, "geometry_authority": {"const": false}, "measurement_status": {"enum": ["none", "uncalibrated", "user_calibrated", "drawing_dimensions_verified"]}, "calibration": {"$ref": "#/$defs/calibration"}}},
    "calibration": {"type": "object", "additionalProperties": false, "required": ["method", "pixels_per_mm", "verified"], "properties": {"method": {"enum": ["known_length", "drawing_scale", "manual" ]}, "pixels_per_mm": {"type": "number", "exclusiveMinimum": 0}, "verified": {"type": "boolean"}}},
    "measurement": {"type": "object", "additionalProperties": false, "required": ["dimension_id", "source", "axis", "value_mm", "tolerance_mm", "status"], "properties": {"dimension_id": {"$ref": "#/$defs/id"}, "source": {"type": "string", "minLength": 1}, "axis": {"enum": ["X", "Y", "Z", "diameter", "radius", "other"]}, "value_mm": {"type": "number", "exclusiveMinimum": 0}, "tolerance_mm": {"type": "number", "minimum": 0}, "status": {"enum": ["verified", "user_calibrated", "unresolved"]}}},
    "volume": {"type": "object", "additionalProperties": false, "required": ["volume_id", "semantic_id", "kind", "min_mm", "max_mm", "clearance_mm", "locked", "source"], "properties": {"volume_id": {"$ref": "#/$defs/id"}, "semantic_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["hardware", "mechanism", "pcb", "battery", "display", "connector", "cable", "human_clearance", "service", "other"]}, "min_mm": {"$ref": "#/$defs/point"}, "max_mm": {"$ref": "#/$defs/point"}, "clearance_mm": {"type": "number", "minimum": 0}, "locked": {"const": true}, "source": {"type": "string", "minLength": 1}}},
    "desire": {"type": "object", "additionalProperties": false, "required": ["desire_id", "statement", "priority", "status"], "properties": {"desire_id": {"$ref": "#/$defs/id"}, "statement": {"type": "string", "minLength": 1}, "priority": {"enum": ["required", "preferred", "exploratory"]}, "status": {"enum": ["unverified", "user_confirmed", "measured"]}}},
    "objective": {"type": "object", "additionalProperties": false, "required": ["objective_id", "metric", "target", "unit", "status"], "properties": {"objective_id": {"$ref": "#/$defs/id"}, "metric": {"enum": ["reach", "grip", "viewing_angle", "finger_clearance", "service_access", "other"]}, "target": {"type": "number"}, "unit": {"type": "string", "minLength": 1}, "status": {"enum": ["verified", "user_confirmed", "unresolved"]}}},
    "material": {"type": "object", "additionalProperties": false, "required": ["region_id", "candidate_materials", "requirements", "evidence_status"], "properties": {"region_id": {"$ref": "#/$defs/id"}, "candidate_materials": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "requirements": {"type": "array", "items": {"type": "string", "minLength": 1}}, "evidence_status": {"enum": ["unverified", "datasheet_backed", "test_backed"]}}},
    "manufacturing": {"type": "object", "additionalProperties": false, "required": ["processes", "units", "minimum_wall_mm", "minimum_feature_mm", "status"], "properties": {"processes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "units": {"const": "mm"}, "minimum_wall_mm": {"type": "number", "exclusiveMinimum": 0}, "minimum_feature_mm": {"type": "number", "exclusiveMinimum": 0}, "status": {"enum": ["provisional", "process_reviewed", "supplier_confirmed"]}}},
    "hardConstraints": {"type": "object", "additionalProperties": false, "required": ["locked_envelope", "max_external_dimensions_mm", "minimum_clearance_mm", "require_watertight_solid", "forbid_interference"], "properties": {"locked_envelope": {"$ref": "#/$defs/bounds"}, "max_external_dimensions_mm": {"$ref": "#/$defs/point"}, "minimum_clearance_mm": {"type": "number", "minimum": 0}, "require_watertight_solid": {"type": "boolean"}, "forbid_interference": {"type": "boolean"}}},
    "weights": {"type": "object", "additionalProperties": false, "required": ["occupied_volume", "reach", "clearance", "wall", "continuity", "manufacturability", "mass", "material_use", "user_priority"], "properties": {"occupied_volume": {"type": "number", "minimum": 0}, "reach": {"type": "number", "minimum": 0}, "clearance": {"type": "number", "minimum": 0}, "wall": {"type": "number", "minimum": 0}, "continuity": {"type": "number", "minimum": 0}, "manufacturability": {"type": "number", "minimum": 0}, "mass": {"type": "number", "minimum": 0}, "material_use": {"type": "number", "minimum": 0}, "user_priority": {"type": "number", "minimum": 0}}},
    "authority": {"type": "object", "additionalProperties": false, "required": ["authoritative_sources", "raster_and_sketch_are_geometry_authority", "unknown_dimensions_policy"], "properties": {"authoritative_sources": {"const": ["freecad_brep", "typed_mechanical_cad_program", "verified_measurements"]}, "raster_and_sketch_are_geometry_authority": {"const": false}, "unknown_dimensions_policy": {"const": "blocked_until_measured_or_explicitly_constrained"}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["exact_candidate_count", "labels", "ranking_policy"], "properties": {"exact_candidate_count": {"const": 3}, "labels": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "ranking_policy": {"const": "hard_failures_removed_missing_analysis_incomplete"}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "label", "status", "program", "score_breakdown", "hard_failures", "analysis", "semantic_ids"], "properties": {"candidate_id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/id"}, "status": {"enum": ["incomplete", "passed", "rejected"]}, "program": {"type": ["object", "null"]}, "score_breakdown": {"type": "object", "additionalProperties": {"type": ["number", "null"]}}, "hard_failures": {"type": "array", "items": {"type": "string", "minLength": 1}}, "analysis": {"type": "object", "additionalProperties": {"type": "object"}}, "semantic_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "rank": {"type": ["integer", "null"], "minimum": 1}, "shape_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["created_by", "created_utc", "user_prompt"], "properties": {"created_by": {"type": "string", "minLength": 1}, "created_utc": {"type": "string", "minLength": 1}, "user_prompt": {"type": "string", "minLength": 1}}}
  }
}
