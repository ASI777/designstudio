{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:surface-design:2",
  "title": "DesignStudio vector surface design v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "design_id", "units", "author", "envelope", "sections", "guides", "continuity", "parameters", "provenance"],
  "properties": {
    "schema": {"const": "design-studio.surface-design/2"},
    "design_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "units": {"const": "mm"},
    "author": {"type": "string", "minLength": 1},
    "envelope": {"type": "object", "additionalProperties": false, "required": ["min_mm", "max_mm"], "properties": {"min_mm": {"$ref": "#/$defs/point"}, "max_mm": {"$ref": "#/$defs/point"}}},
    "sections": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/station"}},
    "guides": {"type": "array", "items": {"$ref": "#/$defs/guide"}},
    "continuity": {"$ref": "#/$defs/continuity"},
    "parameters": {"type": "object"},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "point": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false, "minItems": 3, "maxItems": 3},
    "curve": {"type": "object", "additionalProperties": false, "required": ["degree", "knots", "multiplicities", "weights", "control_points", "closed", "periodic", "classification", "provenance"], "properties": {"degree": {"type": "integer", "minimum": 1, "maximum": 8}, "knots": {"type": "array", "minItems": 2, "items": {"type": "number"}}, "multiplicities": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1}}, "weights": {"type": "array", "minItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}}, "control_points": {"type": "array", "minItems": 2, "maxItems": 2048, "items": {"$ref": "#/$defs/point"}}, "closed": {"type": "boolean"}, "periodic": {"type": "boolean"}, "classification": {"enum": ["reference-locked", "compatible-interface", "original-designed"]}, "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "station": {"type": "object", "additionalProperties": false, "required": ["id", "station_mm", "curve"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"}, "station_mm": {"type": "number"}, "curve": {"$ref": "#/$defs/curve"}}},
    "guide": {"type": "object", "additionalProperties": false, "required": ["id", "curve"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"}, "curve": {"$ref": "#/$defs/curve"}}},
    "continuity": {"type": "object", "additionalProperties": false, "required": ["required", "max_normal_angle_deg"], "properties": {"required": {"enum": ["G0", "G1", "G2"]}, "max_normal_angle_deg": {"type": "number", "minimum": 0, "maximum": 180}, "max_curvature_delta": {"type": "number", "minimum": 0}}}
  }
}
