{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designstudio.local/schemas/robot-coupled-thermal-contract-v1.schema.json",
  "title": "DesignStudio coupled joint thermal-network contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "product_id", "requirements_sha256", "network_nodes",
    "boundary_conditions", "joints", "power_stage_screen_result",
    "coupled_network_result", "required_inputs", "required_validation"
  ],
  "properties": {
    "schema": {"const": "design-studio.robot-coupled-thermal-contract/1"},
    "product_id": {"type": "string", "minLength": 1},
    "requirements_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "network_nodes": {
      "type": "array", "minItems": 9, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "boundary_conditions": {
      "type": "object", "additionalProperties": false,
      "required": [
        "maximum_ambient_degc", "maximum_motor_winding_degc",
        "maximum_driver_junction_degc", "continuous_duty_factor_max"
      ],
      "properties": {
        "maximum_ambient_degc": {"type": "number"},
        "maximum_motor_winding_degc": {"type": "number"},
        "maximum_driver_junction_degc": {"type": "number"},
        "continuous_duty_factor_max": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "joints": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {"$ref": "#/$defs/joint"}
    },
    "power_stage_screen_result": {"const": "pass_candidate_paths"},
    "coupled_network_result": {"const": "incomplete_exact_motor_and_path_data_missing"},
    "required_inputs": {"$ref": "#/$defs/stringArray"},
    "required_validation": {"$ref": "#/$defs/stringArray"}
  },
  "$defs": {
    "nullableNumber": {"type": ["number", "null"]},
    "stringArray": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "joint": {
      "type": "object", "additionalProperties": false,
      "required": [
        "joint_id", "known_heat_sources_w", "known_thermal_paths_degc_per_w",
        "uncoupled_power_stage_junction_degc", "power_stage_junction_margin_degc",
        "power_stage_screen_status", "motor_winding_temperature_degc",
        "coupled_solution_status"
      ],
      "properties": {
        "joint_id": {"type": "string", "pattern": "^J[1-7]$"},
        "known_heat_sources_w": {
          "type": "object", "additionalProperties": false,
          "required": [
            "power_stage_continuous_budget", "motor_copper", "motor_core",
            "reducer_and_bearing", "brake_coil_released"
          ],
          "properties": {
            "power_stage_continuous_budget": {"type": "number", "minimum": 0},
            "motor_copper": {"$ref": "#/$defs/nullableNumber"},
            "motor_core": {"$ref": "#/$defs/nullableNumber"},
            "reducer_and_bearing": {"$ref": "#/$defs/nullableNumber"},
            "brake_coil_released": {"$ref": "#/$defs/nullableNumber"}
          }
        },
        "known_thermal_paths_degc_per_w": {
          "type": "object", "additionalProperties": false,
          "required": [
            "power_stage_to_ambient_candidate_max", "junction_to_board", "board_to_hub",
            "winding_to_stator", "stator_to_hub", "hub_to_ambient",
            "joint_to_adjacent_links"
          ],
          "properties": {
            "power_stage_to_ambient_candidate_max": {"type": "number", "exclusiveMinimum": 0},
            "junction_to_board": {"$ref": "#/$defs/nullableNumber"},
            "board_to_hub": {"$ref": "#/$defs/nullableNumber"},
            "winding_to_stator": {"$ref": "#/$defs/nullableNumber"},
            "stator_to_hub": {"$ref": "#/$defs/nullableNumber"},
            "hub_to_ambient": {"$ref": "#/$defs/nullableNumber"},
            "joint_to_adjacent_links": {"$ref": "#/$defs/nullableNumber"}
          }
        },
        "uncoupled_power_stage_junction_degc": {"type": "number"},
        "power_stage_junction_margin_degc": {"type": "number", "minimum": 0},
        "power_stage_screen_status": {"const": "pass_candidate_path_not_measured"},
        "motor_winding_temperature_degc": {"type": "null"},
        "coupled_solution_status": {"const": "incomplete_motor_and_interface_parameters_missing"}
      }
    }
  }
}
