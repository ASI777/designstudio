{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:configuration:1",
  "title": "Immutable DesignStudio product configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "configuration_id", "revision", "parent_configuration_id", "baseline_configuration_id", "workspace_revision", "graph_revision", "state", "equipped", "parameter_overrides", "requirement_profile", "created_utc", "digest"],
  "properties": {
    "schema": {"const": "design-studio.configuration/1"},
    "configuration_id": {"$ref": "#/$defs/uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "parent_configuration_id": {"oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]},
    "baseline_configuration_id": {"$ref": "#/$defs/uuid"},
    "workspace_revision": {"type": "integer", "minimum": 1},
    "graph_revision": {"type": "integer", "minimum": 1},
    "state": {"enum": ["sandbox", "committed", "released"]},
    "equipped": {"type": "object", "propertyNames": {"pattern": "^slot\\."}, "additionalProperties": {"type": "string", "minLength": 1}},
    "parameter_overrides": {"type": "object"},
    "requirement_profile": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {"uuid": {"type": "string", "format": "uuid"}}
}
