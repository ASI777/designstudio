{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:inference-usage:1",
  "title": "DesignStudio provider-reported inference token usage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "provider", "model", "purpose", "measurement", "budget_policy", "input_tokens", "output_tokens", "total_tokens", "cached_input_tokens", "uncached_input_tokens", "cache_reuse_ratio", "reason", "optimizations", "usage_digest"],
  "properties": {
    "schema": {"const": "design-studio.inference-usage/1"},
    "status": {"enum": ["measured", "unavailable"]},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "measurement": {"const": "provider_reported_only"},
    "budget_policy": {"const": "observe_only_no_hard_cap"},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "total_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "uncached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cache_reuse_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "reason": {"type": ["string", "null"]},
    "optimizations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "usage_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
