{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:incremental-analysis:1",
  "title": "Incremental schematic and electrical analysis report",
  "type": "object",
  "required": ["schema", "revision", "status", "changed_refs", "recomputed_nets", "categories", "schematic"],
  "properties": {
    "schema": {"const": "design-studio.incremental-analysis/1"},
    "revision": {"type": "integer", "minimum": 0},
    "status": {"$ref": "#/$defs/status"},
    "changed_refs": {"type": "array", "items": {"type": "string"}},
    "recomputed_nets": {"type": "array", "items": {"type": "string"}},
    "event_log": {"type": "array", "items": {"type": "object"}},
    "categories": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/category"}
    },
    "schematic": {"type": "object"},
    "missing_bindings": {"type": "array", "items": {"type": "object"}},
    "invalid_bindings": {"type": "array", "items": {"type": "object"}},
    "generated_utc": {"type": "string", "format": "date-time"},
    "project": {"type": "object", "required": ["document_id", "revision", "file_sha256"]},
    "report_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "status": {"enum": ["pass", "fail", "incomplete", "not_applicable"]},
    "category": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "findings": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
