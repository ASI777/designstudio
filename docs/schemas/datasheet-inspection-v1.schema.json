{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-studio.local/schemas/datasheet-inspection-v1.schema.json",
  "title": "Datasheet visual inspection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requested_mpn", "identified_mpn", "package_variant", "confidence", "regions", "warnings"],
  "properties": {
    "schema": {"const": "design-studio.datasheet-inspection/1"},
    "requested_mpn": {"type": "string"},
    "identified_mpn": {"type": "string"},
    "package_variant": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "role", "bbox_normalized", "evidence_summary"],
        "properties": {
          "page": {"type": "integer", "minimum": 1},
          "role": {"enum": ["overview", "ordering", "pinout", "pin_table", "package", "land_pattern", "orientation", "other"]},
          "bbox_normalized": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "evidence_summary": {"type": "string", "minLength": 1, "maxLength": 1000},
          "printed_callouts": {"type": "array", "items": {"type": "string"}, "maxItems": 64}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
