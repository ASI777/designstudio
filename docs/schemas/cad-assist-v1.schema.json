{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:cad-assist-session:1",
  "title": "Design Studio CAD-assist evidence session",
  "description": "Portable drawing evidence and CAD comparison data. This is not a project file or an authorization to mutate CAD.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "producer", "created_at", "session_id", "revision",
    "idempotency_key", "status", "geometry_units",
    "canonical_scale_nm_per_mm", "project", "source", "calibrations",
    "viewboxes", "targets", "elements", "deviations", "dataset_policy",
    "producer_validation"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "stable_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "point2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false
    },
    "point3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"type": "number"}, {"type": "number"}, {"type": "number"}
      ],
      "items": false
    },
    "rect4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"type": "number"}, {"type": "number"},
        {"type": "number"}, {"type": "number"}
      ],
      "items": false
    },
    "matrix16": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"type": "number"}
    },
    "managed_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "sha256", "media_type", "byte_size"],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^assets/[A-Za-z0-9._/-]+$",
          "not": {"pattern": "(^|/)\\.\\.(/|$)"}
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 127},
        "byte_size": {"type": "integer", "minimum": 0, "maximum": 52428800}
      }
    },
    "plane_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_mm", "u_axis", "v_axis", "normal", "local_to_world_mm",
        "handedness", "binding_status", "plane_hint"
      ],
      "properties": {
        "origin_mm": {"$ref": "#/$defs/point3"},
        "u_axis": {"$ref": "#/$defs/point3"},
        "v_axis": {"$ref": "#/$defs/point3"},
        "normal": {"$ref": "#/$defs/point3"},
        "local_to_world_mm": {"$ref": "#/$defs/matrix16"},
        "handedness": {"enum": ["right", "left"]},
        "binding_status": {"enum": ["suggested", "confirmed"]},
        "plane_hint": {"enum": ["XY", "XZ", "YZ", "arbitrary", "unknown"]},
        "datum_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_id"}
        }
      }
    },
    "polyline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points_view_mm", "closed"],
      "properties": {
        "points_view_mm": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/point2"}
        },
        "closed": {"type": "boolean"}
      }
    }
  },
  "properties": {
    "schema": {"const": "urn:design-studio:schema:cad-assist-session:1"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "runtime"],
      "properties": {
        "name": {"const": "cad-visual-helper"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "runtime": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "session_id": {"$ref": "#/$defs/uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"$ref": "#/$defs/uuid"},
    "status": {"enum": ["draft", "ready", "invalid"]},
    "geometry_units": {"const": "mm"},
    "canonical_scale_nm_per_mm": {"const": 1000000},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "base_revision"],
      "properties": {
        "document_id": {"$ref": "#/$defs/stable_id"},
        "base_revision": {"type": "integer", "minimum": 0},
        "base_sha256": {"$ref": "#/$defs/sha256"},
        "object_id": {"$ref": "#/$defs/stable_id"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256", "original_name", "page_count", "coordinate_system", "pages"
      ],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "original_name": {"type": "string", "minLength": 1, "maxLength": 255},
        "page_count": {"type": "integer", "minimum": 1},
        "coordinate_system": {
          "type": "object",
          "additionalProperties": false,
          "required": ["frame", "units", "origin", "x_axis", "y_axis", "rotation_applied"],
          "properties": {
            "frame": {"const": "pdf_viewed_page"},
            "units": {"const": "pt"},
            "origin": {"const": "top_left"},
            "x_axis": {"const": "right"},
            "y_axis": {"const": "down"},
            "rotation_applied": {"const": true}
          }
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "record_status", "rotation_deg", "media_box_pdf_pt", "crop_box_pdf_pt"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "record_status": {"enum": ["recorded", "unknown"]},
              "rotation_deg": {
                "oneOf": [
                  {"enum": [0, 90, 180, 270]},
                  {"type": "null"}
                ]
              },
              "media_box_pdf_pt": {
                "oneOf": [{"$ref": "#/$defs/rect4"}, {"type": "null"}]
              },
              "crop_box_pdf_pt": {
                "oneOf": [{"$ref": "#/$defs/rect4"}, {"type": "null"}]
              }
            }
          }
        }
      }
    },
    "calibrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "page", "scale_mm_per_pt", "rotation_deg", "tx_mm", "ty_mm",
          "flip_y", "measured_distance_mm", "anchors", "residual_mm",
          "uncertainty_mm", "review_status"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/uuid"},
          "page": {"type": "integer", "minimum": 0},
          "scale_mm_per_pt": {"type": "number", "exclusiveMinimum": 0},
          "rotation_deg": {"type": "number"},
          "tx_mm": {"type": "number"},
          "ty_mm": {"type": "number"},
          "flip_y": {"type": "boolean"},
          "measured_distance_mm": {"type": "number", "exclusiveMinimum": 0},
          "anchors": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pdf_point_pt", "view_point_mm", "role"],
              "properties": {
                "pdf_point_pt": {"$ref": "#/$defs/point2"},
                "view_point_mm": {"$ref": "#/$defs/point2"},
                "role": {"enum": ["origin", "distance_endpoint", "correspondence"]}
              }
            }
          },
          "residual_mm": {"type": ["number", "null"], "minimum": 0},
          "uncertainty_mm": {"type": ["number", "null"], "minimum": 0},
          "review_status": {"enum": ["needs_review", "confirmed"]}
        }
      }
    },
    "viewboxes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "page", "rect_pdf_pt", "label", "classification",
          "calibration_id", "frame"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/uuid"},
          "legacy_id": {"type": "integer", "minimum": 1},
          "page": {"type": "integer", "minimum": 0},
          "rect_pdf_pt": {"$ref": "#/$defs/rect4"},
          "label": {"type": "string", "minLength": 1, "maxLength": 64},
          "classification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "confidence", "caption"],
            "properties": {
              "source": {"enum": ["caption", "ai", "user"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "caption": {"type": "string", "maxLength": 1024}
            }
          },
          "calibration_id": {"$ref": "#/$defs/uuid"},
          "frame": {"$ref": "#/$defs/plane_frame"},
          "crop_asset": {"$ref": "#/$defs/managed_asset"}
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "label", "page", "viewbox_id", "snap_point_pdf_pt",
          "snap_point_view_mm", "snap_kind", "entity_kind", "closed",
          "points_view_mm", "evidence"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/uuid"},
          "legacy_id": {"type": "integer", "minimum": 1},
          "label": {"type": "string", "maxLength": 256},
          "page": {"type": "integer", "minimum": 0},
          "viewbox_id": {
            "oneOf": [{"$ref": "#/$defs/uuid"}, {"type": "null"}]
          },
          "snap_point_pdf_pt": {"$ref": "#/$defs/point2"},
          "snap_point_view_mm": {"$ref": "#/$defs/point2"},
          "snap_kind": {"enum": ["endpoint", "midpoint", "on-segment", "free"]},
          "entity_kind": {"type": "string", "maxLength": 64},
          "closed": {"type": "boolean"},
          "points_view_mm": {
            "type": "array",
            "items": {"$ref": "#/$defs/point2"}
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity_signature", "extractor", "nearby_text"],
            "properties": {
              "entity_signature": {"$ref": "#/$defs/sha256"},
              "extractor": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "version"],
                "properties": {
                  "name": {"type": "string", "minLength": 1, "maxLength": 64},
                  "version": {"type": "string", "minLength": 1, "maxLength": 64}
                }
              },
              "nearby_text": {
                "type": "array",
                "items": {"type": "string", "maxLength": 512}
              }
            }
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "label", "page", "viewbox_id", "tracker_ids",
          "start_point_view_mm", "polylines", "references"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/uuid"},
          "legacy_id": {"type": "integer", "minimum": 1},
          "label": {"type": "string", "maxLength": 256},
          "page": {"type": "integer", "minimum": 0},
          "viewbox_id": {"$ref": "#/$defs/uuid"},
          "tracker_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/uuid"}
          },
          "start_point_view_mm": {"$ref": "#/$defs/point2"},
          "polylines": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/polyline"}
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id", "pick_pdf_pt", "raw_text", "nominal_mm",
                "lower_tolerance_mm", "upper_tolerance_mm", "kind",
                "multiplicity", "units", "authority"
              ],
              "properties": {
                "id": {"$ref": "#/$defs/uuid"},
                "pick_pdf_pt": {"$ref": "#/$defs/point2"},
                "raw_text": {"type": "string", "maxLength": 1024},
                "nominal_mm": {"type": ["number", "null"]},
                "lower_tolerance_mm": {"type": ["number", "null"], "minimum": 0},
                "upper_tolerance_mm": {"type": ["number", "null"], "minimum": 0},
                "kind": {"enum": ["linear", "radius", "diameter", "angle", "thread", "count", "unknown"]},
                "multiplicity": {"type": "integer", "minimum": 1},
                "units": {"enum": ["mm", "deg", "count", "unknown"]},
                "authority": {"enum": ["callout", "derived", "linework", "user"]}
              }
            }
          }
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "element_id", "cad_object_id", "host_geometry_id",
          "sketch_revision", "status", "tolerance_mm", "metrics"
        ],
        "properties": {
          "id": {"$ref": "#/$defs/uuid"},
          "element_id": {"$ref": "#/$defs/uuid"},
          "cad_object_id": {"$ref": "#/$defs/stable_id"},
          "host_geometry_id": {"$ref": "#/$defs/stable_id"},
          "sketch_revision": {"type": "integer", "minimum": 0},
          "geometry_index": {"type": "integer", "minimum": 0},
          "status": {"enum": ["within_tolerance", "deviates", "unmatched"]},
          "tolerance_mm": {"type": "number", "exclusiveMinimum": 0},
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_error_mm", "end_error_mm", "length_error_mm",
              "angle_error_deg", "max_error_mm"
            ],
            "properties": {
              "start_error_mm": {"type": "number", "minimum": 0},
              "end_error_mm": {"type": "number", "minimum": 0},
              "length_error_mm": {"type": "number"},
              "angle_error_deg": {"type": "number"},
              "max_error_mm": {"type": "number", "minimum": 0}
            }
          },
          "suggested_target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "target_start_view_mm", "target_end_view_mm"],
            "properties": {
              "kind": {"const": "replace_line_constraints"},
              "target_start_view_mm": {"$ref": "#/$defs/point2"},
              "target_end_view_mm": {"$ref": "#/$defs/point2"}
            }
          },
          "proposal_id": {"$ref": "#/$defs/uuid"}
        }
      }
    },
    "dataset_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["training_consent", "content_classification", "source_rights"],
      "properties": {
        "training_consent": {"type": "boolean"},
        "content_classification": {"enum": ["public", "internal", "customer_confidential", "restricted"]},
        "source_rights": {"enum": ["unknown", "customer_provided", "licensed", "public_domain"]}
      }
    },
    "producer_validation": {
      "description": "Advisory producer result only. Every consumer must validate independently.",
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "validator", "errors", "warnings"],
      "properties": {
        "valid": {"type": "boolean"},
        "validator": {"type": "string", "minLength": 1, "maxLength": 128},
        "errors": {"type": "array", "items": {"type": "string", "maxLength": 1024}},
        "warnings": {"type": "array", "items": {"type": "string", "maxLength": 1024}}
      }
    }
  }
}
