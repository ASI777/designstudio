{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designstudio.local/schemas/robot-thermal-budget-v2.schema.json",
  "title": "DesignStudio robot thermal budget",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "maximum_ambient_degc", "maximum_motor_winding_degc",
    "maximum_driver_junction_degc", "motor_winding_analysis_status",
    "coupled_thermal_contract", "power_stage_loss_screen", "joint_budgets", "reference_influence",
    "required_next_artifacts"
  ],
  "properties": {
    "schema": {"const": "design-studio.robot-thermal-budget/2"},
    "maximum_ambient_degc": {"type": "number"},
    "maximum_motor_winding_degc": {"type": "number"},
    "maximum_driver_junction_degc": {"type": "number"},
    "motor_winding_analysis_status": {
      "const": "incomplete_motor_loss_map_and_thermal_network_missing"
    },
    "coupled_thermal_contract": {"const": "thermal/coupled-thermal-contract.json"},
    "power_stage_loss_screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mosfet_rds_on_25c_max_ohm", "assumed_hot_resistance_factor",
        "gate_drive_screening_voltage_v", "control_frequency_hz",
        "phase_shunt_resistance_ohm", "unresolved_terms"
      ],
      "properties": {
        "mosfet_rds_on_25c_max_ohm": {"type": "number", "exclusiveMinimum": 0},
        "assumed_hot_resistance_factor": {"type": "number", "minimum": 1},
        "gate_drive_screening_voltage_v": {"type": "number", "exclusiveMinimum": 0},
        "control_frequency_hz": {"type": "number", "exclusiveMinimum": 0},
        "phase_shunt_resistance_ohm": {"type": "number", "exclusiveMinimum": 0},
        "unresolved_terms": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "joint_budgets": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {"$ref": "#/$defs/jointBudget"}
    },
    "reference_influence": {"type": "string", "minLength": 1},
    "required_next_artifacts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "nonnegative": {"type": "number", "minimum": 0},
    "positive": {"type": "number", "exclusiveMinimum": 0},
    "jointBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "joint_id", "efficiency_based_continuous_loss_w",
        "component_screen_continuous_loss_w", "continuous_power_stage_loss_budget_w",
        "loss_budget_basis", "hot_two_mosfet_path_loss_w", "three_shunt_peak_loss_w",
        "six_mosfet_gate_charge_power_w",
        "maximum_power_stage_to_ambient_thermal_resistance_degc_per_w",
        "selected_thermal_resistance_degc_per_w", "heat_path",
        "temperature_sensitive_zone"
      ],
      "properties": {
        "joint_id": {"type": "string", "pattern": "^J[1-7]$"},
        "efficiency_based_continuous_loss_w": {"$ref": "#/$defs/nonnegative"},
        "component_screen_continuous_loss_w": {"$ref": "#/$defs/nonnegative"},
        "continuous_power_stage_loss_budget_w": {"$ref": "#/$defs/nonnegative"},
        "loss_budget_basis": {"enum": ["component_loss_screen", "drive_efficiency_budget"]},
        "hot_two_mosfet_path_loss_w": {"$ref": "#/$defs/nonnegative"},
        "three_shunt_peak_loss_w": {"$ref": "#/$defs/nonnegative"},
        "six_mosfet_gate_charge_power_w": {"$ref": "#/$defs/nonnegative"},
        "maximum_power_stage_to_ambient_thermal_resistance_degc_per_w": {
          "$ref": "#/$defs/positive"
        },
        "selected_thermal_resistance_degc_per_w": {"$ref": "#/$defs/positive"},
        "heat_path": {"type": "string", "minLength": 1},
        "temperature_sensitive_zone": {"type": "string", "minLength": 1}
      }
    }
  }
}
