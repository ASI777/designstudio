{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designstudio.local/schemas/kv-cache-benchmark-v1.schema.json",
  "title": "Design Studio KV Cache Benchmark Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "created_at",
    "variant",
    "server_apc_expected",
    "model",
    "model_revision",
    "image_digest",
    "seed",
    "context_tokens_requested",
    "concurrency",
    "repeats",
    "prefix_sha256",
    "summary",
    "samples",
    "prometheus_before",
    "prometheus_after"
  ],
  "properties": {
    "schema": { "const": "design-studio.kv-benchmark/1" },
    "created_at": { "type": "string", "format": "date-time" },
    "variant": { "enum": ["apc_off", "apc_on"] },
    "server_apc_expected": { "type": "boolean" },
    "model": { "type": "string", "minLength": 1 },
    "model_revision": { "type": "string", "minLength": 7 },
    "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "seed": { "const": 0 },
    "context_tokens_requested": { "enum": [4096, 16384, 65536] },
    "concurrency": { "enum": [1, 4, 8] },
    "repeats": { "type": "integer", "minimum": 1 },
    "warmups": { "type": "integer", "minimum": 0, "maximum": 8 },
    "prefix_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "summary": {
      "type": "object",
      "required": ["requests", "ttft_ms", "e2e_ms", "itl_ms_mean", "output_tokens_per_second_mean", "prompt_tokens_observed"]
    },
    "samples": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "prometheus_before": { "type": "object", "additionalProperties": { "type": "number" } },
    "prometheus_after": { "type": "object", "additionalProperties": { "type": "number" } }
    ,
    "gpu_utilization": {
      "type": "object",
      "required": ["sample_count", "mean_percent", "p95_percent", "samples_at_or_above_80_percent"]
    }
  }
}
