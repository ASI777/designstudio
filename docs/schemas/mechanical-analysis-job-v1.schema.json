{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:mechanical-analysis-job:1",
  "title": "Approved geometry exact-analysis job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "job_id", "candidate_id", "analysis_kind", "geometry", "approval", "solver"],
  "properties": {
    "schema": {"const": "design-studio.mechanical-analysis-job/1"},
    "job_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "analysis_kind": {
      "enum": [
        "linear_static",
        "modal_vibration",
        "thermal",
        "nonlinear_contact",
        "drop_impact",
        "plastic_creep_fatigue",
        "injection_moulding_flow_warpage"
      ]
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256", "format", "units"],
      "properties": {
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "format": {"enum": ["step", "iges", "brep", "fcstd", "glb"]},
        "units": {"const": "mm"},
        "artifact_uri": {"type": "string", "minLength": 1}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approved_by", "approval_digest"],
      "properties": {
        "status": {"const": "approved"},
        "approved_by": {"type": "string", "minLength": 1},
        "approval_digest": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string"}
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker", "backend"],
      "properties": {
        "worker": {"type": "string", "minLength": 1},
        "backend": {"enum": ["auto", "cpu", "cuda", "remote"]},
        "max_iterations": {"type": "integer", "minimum": 1},
        "tolerance": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "solver_input": {
      "type": "object",
      "description": "Canonical numerical input for a worker; never inferred from a mesh by the AI.",
      "additionalProperties": true
    },
    "qualification_contract": {
      "type": "object",
      "additionalProperties": true
    },
    "loads": {"type": "object"},
    "constraints": {"type": "object"},
    "provenance": {"type": "object"}
  }
}
