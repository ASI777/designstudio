{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:update-manifest:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "channel", "version", "published_utc", "artifacts", "signature"],
  "properties": {
    "schema": {"const": "design-studio.update-manifest/1"},
    "channel": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "published_utc": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["platform", "filename", "sha256", "bytes"],
        "properties": {
          "platform": {"type": "string", "minLength": 1},
          "filename": {"type": "string", "pattern": "^[^/\\\\]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    },
    "signature": {"type": "object", "required": ["algorithm", "key_id", "public_key_base64", "signed_digest", "signature_base64"]}
  }
}
