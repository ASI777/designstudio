{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:mechanical-analysis-result:1",
  "title": "Exact mechanical analysis result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "job_id", "candidate_id", "analysis_kind", "status", "worker", "metrics", "evidence", "warnings", "release_eligible", "result_digest"],
  "properties": {
    "schema": {"const": "design-studio.mechanical-analysis-result/1"},
    "job_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "analysis_kind": {"type": "string", "minLength": 1},
    "status": {"enum": ["pass", "fail", "incomplete", "unavailable"]},
    "worker": {
      "type": "object",
      "required": ["name", "version", "backend"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "backend": {"type": "string"}
      }
    },
    "metrics": {"type": "object"},
    "evidence": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "release_eligible": {"type": "boolean"},
    "result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
