{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://designstudio.local/schemas/engineering-workflow-run-v1.schema.json",
  "title": "Executed engineering workflow state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "workflow_id", "status", "active_nodes", "completed_nodes", "state", "history"],
  "properties": {
    "schema": {"const": "design-studio.engineering-workflow-run/1"},
    "workflow_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["active", "complete"]},
    "active_nodes": {
      "type": "array",
      "maxItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "completed_nodes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id", "revision", "requirements_sha256", "evidence_digests",
        "rights_constraints", "observations", "changed_domains",
        "domain_artifact_digests", "interface_findings", "deterministic_failures",
        "qualification_findings", "bundle_digest_verified", "iteration",
        "inference_usage_records"
      ],
      "properties": {
        "product_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "requirements_sha256": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/sha256"}]},
        "evidence_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}, "uniqueItems": true},
        "rights_constraints": {"$ref": "#/$defs/stringArray"},
        "observations": {"$ref": "#/$defs/stringArray"},
        "changed_domains": {"$ref": "#/$defs/stringArray"},
        "domain_artifact_digests": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        },
        "interface_findings": {"$ref": "#/$defs/recordArray"},
        "deterministic_failures": {"$ref": "#/$defs/recordArray"},
        "qualification_findings": {"$ref": "#/$defs/recordArray"},
        "bundle_digest_verified": {"type": "boolean"},
        "iteration": {"type": "integer", "minimum": 0},
        "inference_usage_records": {"$ref": "#/$defs/recordArray"}
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "actor_kind", "written_fields", "selected_condition", "next_nodes"],
        "properties": {
          "node_id": {"type": "string", "minLength": 1},
          "actor_kind": {"enum": ["software", "ai", "solver_or_test_worker"]},
          "written_fields": {"$ref": "#/$defs/stringArray"},
          "selected_condition": {"type": "string", "minLength": 1},
          "next_nodes": {"type": "array", "maxItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
      "then": {"properties": {"active_nodes": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "recordArray": {
      "type": "array",
      "items": {"type": "object"}
    }
  }
}
