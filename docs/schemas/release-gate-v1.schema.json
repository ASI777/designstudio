{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:release-gate:1",
  "type": "object",
  "required": ["schema", "generated_utc", "status", "project_sha256", "verification_sha256", "errors", "warnings", "counts"],
  "properties": {
    "schema": {"const": "design-studio.release-gate/1"},
    "generated_utc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["ready", "blocked"]},
    "project_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "verification_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "errors": {"type": "array"}, "warnings": {"type": "array"},
    "counts": {"type": "object"}
  },
  "additionalProperties": false
}
