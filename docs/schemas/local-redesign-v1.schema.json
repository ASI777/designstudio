{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:local-redesign:1",
  "title": "DesignStudio bounded local redesign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "redesign_id", "revision", "status", "document", "selection",
    "intent", "constraints", "program", "candidate_command_id", "drawing_output",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "design-studio.local-redesign/1"},
    "redesign_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["captured", "program_ready"]},
    "document": {"$ref": "#/$defs/document"},
    "physical_design_session_path": {"anyOf": [{"$ref": "#/$defs/relativePath"}, {"type": "null"}]},
    "selection": {"$ref": "#/$defs/selection"},
    "intent": {"type": "string", "minLength": 1, "maxLength": 32000},
    "constraints": {"$ref": "#/$defs/constraints"},
    "program": {"type": ["object", "null"]},
    "candidate_command_id": {"type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "drawing_output": {
      "type": "object", "additionalProperties": false,
      "required": ["directory", "views", "formats", "source"],
      "properties": {
        "directory": {"$ref": "#/$defs/relativePath"},
        "views": {"const": ["front", "rear", "left", "right", "top", "bottom"]},
        "formats": {"const": ["svg", "dxf"]},
        "source": {"const": "candidate_freecad_brep"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["created_by", "created_utc", "model_role", "raster_geometry_authority"],
      "properties": {
        "created_by": {"type": "string", "minLength": 1},
        "created_utc": {"type": "string", "format": "date-time"},
        "model_role": {"enum": ["user", "codex_proposal", "deterministic_host"]},
        "raster_geometry_authority": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "captured"}}},
      "then": {"properties": {"program": {"type": "null"}, "candidate_command_id": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "program_ready"}}},
      "then": {"properties": {"program": {"type": "object"}, "candidate_command_id": {"type": "string"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"},
    "point3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -1000000, "maximum": 1000000}},
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["min_mm", "max_mm"],
      "properties": {"min_mm": {"$ref": "#/$defs/point3"}, "max_mm": {"$ref": "#/$defs/point3"}}
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "path", "file_sha256"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/relativePath"},
        "file_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_id", "object_name", "kind", "subelements", "target_shape_sha256", "selection_shape_sha256", "bounds_mm"],
      "properties": {
        "semantic_id": {"type": "string", "minLength": 1},
        "object_name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["object", "faces"]},
        "subelements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^Face[1-9][0-9]*$"}},
        "target_shape_sha256": {"$ref": "#/$defs/digest"},
        "selection_shape_sha256": {"$ref": "#/$defs/digest"},
        "bounds_mm": {"$ref": "#/$defs/bounds"}
      }
    },
    "protectedObject": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_id", "shape_sha256", "clearance_mm"],
      "properties": {
        "semantic_id": {"type": "string", "minLength": 1},
        "shape_sha256": {"$ref": "#/$defs/digest"},
        "clearance_mm": {"type": "number", "minimum": 0, "maximum": 10000}
      }
    },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["max_expansion_mm", "outside_scope_tolerance_mm3", "protected_objects", "unselected_objects_must_remain_unchanged", "baseline_must_be_retained"],
      "properties": {
        "max_expansion_mm": {"type": "number", "minimum": 0, "maximum": 10000},
        "outside_scope_tolerance_mm3": {"type": "number", "minimum": 0, "maximum": 1000000},
        "protected_objects": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/protectedObject"}},
        "unselected_objects_must_remain_unchanged": {"const": true},
        "baseline_must_be_retained": {"const": true}
      }
    }
  }
}
