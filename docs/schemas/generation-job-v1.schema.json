{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:design-studio:schema:generation-job:1",
  "title": "DesignStudio remote generation job",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "job_id", "configuration_id", "slot_id", "provider", "status", "input_digest", "candidate_count", "seeds", "created_utc"],
  "properties": {
    "schema": {"const": "design-studio.generation-job/1"},
    "job_id": {"type": "string", "format": "uuid"},
    "configuration_id": {"type": "string", "format": "uuid"},
    "slot_id": {"type": "string", "pattern": "^slot\\."},
    "provider": {"const": "hunyuan3d-omni-amd"},
    "status": {"enum": ["queued", "running", "succeeded", "failed", "cancelled"]},
    "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_count": {"type": "integer", "minimum": 1, "maximum": 16},
    "seeds": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "created_utc": {"type": "string", "format": "date-time"},
    "artifact_manifest_url": {"type": ["string", "null"], "format": "uri"}
  }
}
