<Application x:Class="DesignStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Dark theme, Altium-style -->
        <SolidColorBrush x:Key="BgDark" Color="#FF1E1F22"/>
        <SolidColorBrush x:Key="BgPanel" Color="#FF2B2D30"/>
        <SolidColorBrush x:Key="BgCanvas" Color="#FF101418"/>
        <SolidColorBrush x:Key="FgText" Color="#FFD0D0D0"/>
        <SolidColorBrush x:Key="Accent" Color="#FF2D7DD2"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource FgText}"/>
        </Style>
    </Application.Resources>
</Application>
