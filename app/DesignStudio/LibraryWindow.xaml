<Window x:Class="DesignStudio.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:DesignStudio.Controls"
        Title="Footprint Library" Width="760" Height="640"
        Background="{StaticResource BgDark}" WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: library list -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Library" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox DockPanel.Dock="Top" x:Name="SearchBox" TextChanged="OnSearch" Margin="0,0,0,4"
                     Background="{StaticResource BgCanvas}" Foreground="{StaticResource FgText}"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Delete" Width="60" Click="OnDelete"/>
                <Button Content="Import JSON…" Width="95" Margin="6,0,0,0" Click="OnImportJson"
                        ToolTip="Import a datasheet-extracted component (docs/datasheet-extractor)"/>
                <Button Content="Extract SVG…" Width="95" Margin="6,0,0,0" Click="OnExtractSvg"
                        ToolTip="Extract dimension graph from layout SVG"/>
                <Button Content="Place on Board" Width="105" Margin="6,0,0,0" Click="OnPlace" FontWeight="Bold"/>
            </StackPanel>
            <ListBox x:Name="LibList" SelectionChanged="OnSelect"
                     Background="{StaticResource BgPanel}" Foreground="{StaticResource FgText}"
                     DisplayMemberPath="Name"/>
        </DockPanel>

        <!-- Right: preview -->
        <DockPanel Grid.Column="1" Margin="8,0">
            <TextBlock DockPanel.Dock="Top" x:Name="PreviewTitle" Text="Preview" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Bottom" x:Name="PreviewInfo" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <Border BorderBrush="{StaticResource BgPanel}" BorderThickness="1">
                <ctrl:FootprintPreview x:Name="Preview"/>
            </Border>
        </DockPanel>
    </Grid>
</Window>
