<Window x:Class="DesignStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:DesignStudio.Controls"
        Title="Design Studio — PCB + 3D" Width="1400" Height="900"
        Background="{StaticResource BgDark}" WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnWindowKeyDown" Closing="OnWindowClosing">

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource BgPanel}" Foreground="{StaticResource FgText}">
            <MenuItem Header="_File">
                <MenuItem Header="New Board" Click="OnNewBoard" InputGestureText="Ctrl+N"/>
                <MenuItem Header="Open…" Click="OnOpenProject" InputGestureText="Ctrl+O"/>
                <Separator/>
                <MenuItem Header="Save" Click="OnSaveProject" InputGestureText="Ctrl+S"/>
                <MenuItem Header="Save As…" Click="OnSaveProjectAs"/>
                <Separator/>
                <MenuItem Header="Export Fabrication Outputs…" Click="OnExportFab"/>
                <MenuItem Header="Export Circuit State (AI advisor)…" Click="OnExportCircuitState"/>
                <Separator/>
                <MenuItem Header="Exit" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="MenuUndo" Header="Undo" Click="OnUndo" InputGestureText="Ctrl+Z"/>
                <MenuItem x:Name="MenuRedo" Header="Redo" Click="OnRedo" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="Select All" Click="OnSelectAll" InputGestureText="Ctrl+A"/>
            </MenuItem>
            <MenuItem Header="_Board">
                <MenuItem Header="Board Setup (size / stackup)…" Click="OnBoardSetup"/>
                <MenuItem Header="Net Classes…" Click="OnNetClasses"/>
                <Separator/>
                <MenuItem Header="Generate Copper Pour…" Click="OnGeneratePour"/>
            </MenuItem>
            <MenuItem Header="_Library">
                <MenuItem Header="Footprint Library Manager…" Click="OnOpenLibrary"/>
                <MenuItem Header="Add Standard Footprint Set (parametric)" Click="OnSeedLibrary"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Run DRC (C++ engine)" Click="OnRunDrc" InputGestureText="Ctrl+D"/>
                <MenuItem Header="Physics Calculator…" Click="OnPhysicsCalculator"/>
                <MenuItem Header="Auto-Place Components" Click="OnAutoPlace"/>
                <MenuItem Header="Route All (batch autorouter)" Click="OnRouteAll"/>
                <MenuItem Header="Apply Advice (AI advisor)…" Click="OnApplyAdvice"/>
                <MenuItem Header="Fanout Power Vias (bond balls to planes)" Click="OnFanoutPowerVias"/>
                <MenuItem Header="Optimize Power Planes (HDI, one-click)" Click="OnOptimizePower"/>
                <MenuItem Header="Schematic Editor…" Click="OnOpenSchematic"/>
                <MenuItem Header="Zoom to Fit" Click="OnZoomFit" InputGestureText="F"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="MenuRatsnest" Header="Ratsnest (unrouted connections)" IsCheckable="True"
                          IsChecked="True" Click="OnToggleRatsnest"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top" Background="{StaticResource BgPanel}">
            <ToolBar Background="{StaticResource BgPanel}">
                <RadioButton x:Name="BtnSelect" Content=" Select " IsChecked="True" Checked="OnToolChanged" Tag="Select"/>
                <RadioButton Content=" Place " Checked="OnToolChanged" Tag="PlaceFootprint"/>
                <RadioButton Content=" Route " Checked="OnToolChanged" Tag="RouteInteractive"/>
                <RadioButton Content=" Auto-Route " Checked="OnToolChanged" Tag="AutoRoute"/>
                <Separator/>
                <TextBlock Text="  Layer: " VerticalAlignment="Center"/>
                <ComboBox x:Name="LayerCombo" Width="110" SelectionChanged="OnLayerSelected"/>
                <Separator/>
                <TextBlock Text="  Footprint: " VerticalAlignment="Center"/>
                <ComboBox x:Name="FootprintCombo" Width="160" SelectedIndex="0" DisplayMemberPath="Name"/>
                <Button Content=" Library… " Click="OnOpenLibrary" Margin="4,0,0,0"/>
                <Separator/>
                <Button Content=" Pour " Click="OnGeneratePour"/>
                <Button Content=" Auto-Place " Click="OnAutoPlace"/>
                <Button Content=" DRC " Click="OnRunDrc"/>
                <Button Content=" Fit " Click="OnZoomFit"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource BgPanel}">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource FgText}"/>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Editor tabs: PCB 2D / Board 3D -->
            <TabControl Grid.Column="0" x:Name="EditorTabs" Background="{StaticResource BgCanvas}"
                        BorderThickness="0" SelectionChanged="OnEditorTabChanged">
                <TabItem Header="PCB Editor">
                    <ctrl:PcbCanvas x:Name="Pcb"/>
                </TabItem>
                <TabItem Header="3D View">
                    <Grid x:Name="View3DHost" Background="{StaticResource BgCanvas}"
                          MouseDown="On3DMouseDown" MouseMove="On3DMouseMove" MouseUp="On3DMouseUp"
                          MouseWheel="On3DMouseWheel">
                        <Viewport3D x:Name="View3D"/>
                        <TextBlock Text="Drag to orbit · wheel to zoom · regenerated from the PCB on tab switch"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8" Opacity="0.5"
                                   Foreground="{StaticResource FgText}" IsHitTestVisible="False"/>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BgPanel}"/>

            <!-- Right dock: properties + DRC + nets -->
            <Grid Grid.Column="2" Background="{StaticResource BgPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="  Properties" FontWeight="Bold" Margin="4,8,4,4"/>
                <StackPanel Grid.Row="1" Margin="8">
                    <TextBlock x:Name="PropText" Text="Nothing selected" TextWrapping="Wrap"/>
                </StackPanel>

                <Expander Grid.Row="2" Header="DRC results" Foreground="{StaticResource FgText}"
                          Margin="6,0,6,0" IsExpanded="False" x:Name="DrcExpander">
                    <ListBox x:Name="DrcList" Background="{StaticResource BgCanvas}"
                             Foreground="{StaticResource FgText}" BorderThickness="0"
                             SelectionChanged="OnDrcItemSelected"/>
                </Expander>

                <Expander Grid.Row="3" Header="Nets (routed length)" Foreground="{StaticResource FgText}"
                          Margin="6,0,6,6" IsExpanded="False" Expanded="OnNetsExpanded">
                    <ListBox x:Name="NetList" MaxHeight="220" Background="{StaticResource BgCanvas}"
                             Foreground="{StaticResource FgText}" BorderThickness="0"/>
                </Expander>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
